  "method": {
    "dW": "dW = effective_scaling * B @ A, computed from saved tensors in float64 on CPU",
    "factorization": "B=Qb@Rb; A.T=Qa@Ra_t; core=Rb@Ra_t.T; core=U@diag(S)@Vh; left=Qb@U; right=Qa@Vh.T; dW=scaling*left@diag(S)@right.T",
    "singular_values": "compact singular values are S*abs(scaling), sorted by the core SVD",
    "rank_formula": "tol = max(dW_rows,dW_columns) * eps_float64 * max_singular_value; rank = count(compact_singular_values > tol), equivalent to numpy.linalg.matrix_rank's standard tolerance",
    "zero_definitions": "compact exact zeros use sigma == 0.0; near zeros use sigma < 1e-12 and include exact zeros. full exact zeros = max(min(dW_shape)-r,0) factorization-implied zeros + compact exact zeros.",
    "principal_angles": "cosines = svdvals(basis_before.T @ basis_after), clipped to [0,1]; left/right singular subspaces and Qb/Qa factor bases are reported separately",
    "same_source_criterion": {
      "required": [
        "same A/B/dW shapes and effective scaling",
        "both factorizations reconstruct their real dW within factor_rtol",
        "left and right full compact singular-subspace min cosine >= 1-direction_tolerance",
        "before singular directions plus after core singular values reconstruct real after dW within replacement_rtol"
      ],
      "direction_tolerance": 1e-05,
      "replacement_rtol": 1e-05,
      "factor_rtol": 1e-08,
      "report_rtol": 1e-05,
      "note": "Individual singular-vector cosines are diagnostic only because signs and degenerate subspaces are non-unique."
    },
    "source_policy": "Directory names never establish provenance. The surgery_report source field and numerical evidence are reported separately."
